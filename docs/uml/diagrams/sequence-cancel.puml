@startuml sequence-cancel
' Диаграмма последовательности: отмена записи с продвижением листа ожидания (UC-08, UC-09, UC-19)
' SDD: представление 005-booking-flow; REQ-FUNC-011, 021, 023; ADR-0004, ADR-0006

skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam dpi 150
skinparam monochrome true
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor white
autonumber

title sd Отменить запись

actor "Посетитель" as V
boundary "SPA\n(браузер)" as SPA
control "BookingService" as S
control "WaitlistService" as W
control "NotificationService" as N
database "PostgreSQL" as DB
actor "Посетитель из\nочереди" as V2

[-> SPA : «Отменить» (из «Мои записи»)
activate SPA
SPA -> S : DELETE /api/bookings/{id}
activate S
create control "tx :Transaction" as TX
S -> TX : <<create>> begin
S -> DB : SELECT … FROM training FOR UPDATE
activate DB
DB --> S : training
alt now > startsAt − cancelDeadline
  S --> SPA : 409 «срок свободной отмены истёк»
  TX -> DB : ROLLBACK
  destroy TX
else срок не истёк
  S -> DB : UPDATE booking SET status = CANCELLED;\nfree_places + 1
  S -> W : promoteFirst(training, now)
  activate W
  opt startsAt − now ≥ 30 мин
    loop для элементов WAITING по позиции
      W -> DB : SELECT первый WAITING
      DB --> W : entry
      break нет пересечений у entry.visitor
        W -> DB : INSERT booking (viaWaitlist);\nfree_places − 1; entry → PROMOTED
        W ->> N : notify(WAITLIST_PROMOTED)
        activate N
        N -> DB : INSERT notification
        deactivate N
      end
      W -> DB : entry → EXPIRED
    end
  end
  W --> S
  deactivate W
  TX -> DB : COMMIT
  destroy TX
  S --> SPA : 200 {status: CANCELLED}
end
deactivate DB
deactivate S
SPA --> V : «Запись отменена», место возвращено
deactivate SPA
...до 60 с (опрос уведомлений, ADR-0005)...
V2 -> N : GET /api/me/notifications/unread-count
N --> V2 : 1 (WAITLIST_PROMOTED)
@enduml
