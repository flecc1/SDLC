@startuml state-training
' Диаграммы состояний: групповое занятие (Training) и элемент листа ожидания (WaitlistEntry)
' SDD: представление 007-booking-states; REQ-FUNC-005, 006, 008, 023; REQ-REL-003

skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam dpi 150
skinparam monochrome true
skinparam StateBackgroundColor white

state "state machine Занятие (Training)" as T {
  [*] --> SCHEDULED : создать занятие\n[capacity > 0]
  state SCHEDULED {
    [*] --> Available
    state "Есть места" as Available
    state "Мест нет" as Full
    Available --> Full : book() [free_places = 1]
    Full --> Available : cancel() [очередь пуста\nили < 30 мин]
    Available --> Available : изменить / notify()
  }
  state IN_PROGRESS
  state FINISHED
  state "CANCELLED" as TCANCELLED : entry / все записи →\nCANCELLED_BY_CLUB;\nочередь → EXPIRED
  SCHEDULED --> IN_PROGRESS : when(now ≥ startsAt)
  IN_PROGRESS --> FINISHED : when(now ≥ endsAt)
  SCHEDULED --> TCANCELLED : отменить занятие\n(администратор)
  FINISHED --> [*]
  TCANCELLED --> [*]
}

state "state machine Элемент листа ожидания (WaitlistEntry)" as W {
  [*] --> WAITING : join() [мест нет]
  WAITING --> PROMOTED : место освободилось\n[нет пересечений]
  WAITING --> LEFT : leave()
  WAITING --> EXPIRED : занятие началось или отменено /\nпересечение у посетителя
  PROMOTED --> [*]
  LEFT --> [*]
  EXPIRED --> [*]
}
@enduml
